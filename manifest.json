      "url": "./index.html?go=cashier",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "أرشيف العمليات",
      "short_name": "الأرشيف",
      "description": "فواتير اليوم وتفاصيل الدفع",
      "url": "./index.html?go=archive",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "العملاء",
      "short_name": "العملاء",
      "description": "دليل العملاء",
      "url": "./index.html?go=customers",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "المنتجات",
      "short_name": "المنتجات",
      "description": "المنتجات والباركود والأسعار",
      "url": "./index.html?go=products",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
