{
  "id": "./",
  "name": "كاشير عصمتيات أسوان",
  "short_name": "كاشير أسوان",
  "description": "كاشير عصمتيات أسوان - فواتير وباركود ودفع إلكتروني",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "portrait",
  "background_color": "#2A1B12",
  "theme_color": "#2A1B12",
  "categories": [
    "business",
    "shopping"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "الكاشير",
      "short_name": "الكاشير",
